# MCP HTTP: статический бинарник + wget для healthcheck.
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY mcp_server/go.mod ./
COPY mcp_server/ ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mcp_server .

FROM alpine:3.21
RUN apk add --no-cache ca-certificates wget
COPY --from=build /out/mcp_server /mcp_server
EXPOSE 7345
USER nobody
ENTRYPOINT ["/mcp_server"]
