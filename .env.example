# Скопировать в .env. Секреты в git не класть.

# Qdrant (task local:up)
QDRANT_URL=http://127.0.0.1:6333

# LM Studio: эмбеддинги и чат — один OpenAI-compatible endpoint
EMBEDDINGS_URL=http://127.0.0.1:1234/v1
LLM_URL=http://127.0.0.1:1234/v1

# Имена — как в GET /v1/models. VECTOR_SIZE = длина data[0].embedding
# у POST /v1/embeddings (не скрытая размерность чат-модели).
EMBEDDINGS_MODEL=
LLM_MODEL=
VECTOR_SIZE=

# Коллекции Qdrant (должны совпадать с configs/default.yaml)
QDRANT_COLLECTION_BUDGET=budget_items
QDRANT_COLLECTION_CONTRACTS=contracts
QDRANT_COLLECTION_OBLIGATIONS=obligations

# mcp_server HTTP (task mcp)
MCP_HTTP_ADDR=127.0.0.1:7345
MCP_URL=http://127.0.0.1:7345

# assistant (Sprint 4). 1–2 круга tool calls на вопрос.
ASSISTANT_MAX_TOOL_ROUNDS=2
ASSISTANT_HTTP_ADDR=127.0.0.1:7346
