# Скопировать в .env. Секреты (ключи, токен) в git не класть.

# --- Хост (task ingest / task mcp / task assistant / task telegram) ---
# Qdrant из compose: task local:up
QDRANT_URL=http://127.0.0.1:6333

# Эмбеддинги — та же модель, что построила индекс. Не DeepSeek и не «другая».
# VECTOR_SIZE = длина data[0].embedding у POST /v1/embeddings.
# Смена модели / размера = переиндексация (task local:down:clean + ingest).
EMBEDDINGS_URL=http://127.0.0.1:1234/v1
EMBEDDINGS_MODEL=
VECTOR_SIZE=

# Чат — DeepSeek API (tools). Локальный LM Studio:
# LLM_URL=http://127.0.0.1:1234/v1 и пустой LLM_API_KEY.
LLM_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Ключ с https://platform.deepseek.com — в git не класть.
LLM_API_KEY=

# Коллекции Qdrant. v1 использует только budget_items.
QDRANT_COLLECTION_BUDGET=budget_items
QDRANT_COLLECTION_CONTRACTS=contracts
QDRANT_COLLECTION_OBLIGATIONS=obligations

# Хостовые MCP/assistant. Не вместе с контейнерами на тех же портах.
MCP_HTTP_ADDR=127.0.0.1:7345
MCP_URL=http://127.0.0.1:7345
ASSISTANT_HTTP_ADDR=127.0.0.1:7346
ASSISTANT_MAX_TOOL_ROUNDS=2
ASSISTANT_LLM_TIMEOUT=180

# Telegram: только POST /chat. Long polling, без webhook.
ASSISTANT_URL=http://127.0.0.1:7346
# Токен у @BotFather. chat_id — свой (число из getUpdates / @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Контейнеры (task local:up / local:ingest / local:telegram) ---
# Qdrant и MCP внутри сети compose подставляет compose.
# Чат из контейнера — тот же DeepSeek, не LM Studio.
LLM_URL_DOCKER=https://api.deepseek.com

# Эмбеддинги из контейнера. Локально Mac/Docker Desktop:
EMBEDDINGS_URL_DOCKER=http://host.docker.internal:1234/v1
# VPS: URL, который видят контейнеры, та же модель и VECTOR_SIZE.
# Если сервер эмбеддингов на том же хосте (как LM Studio / sidecar):
#   EMBEDDINGS_URL_DOCKER=http://host.docker.internal:1234/v1
# Если уже есть совместимый /v1/embeddings в сети сервера:
#   EMBEDDINGS_URL_DOCKER=http://<хост-в-сети>:1234/v1
# Не ставить api.deepseek.com и не менять EMBEDDINGS_MODEL без переиндексации.
